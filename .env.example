# ==============================================================================
# Talk With Astrologers - Production & Environment Configuration Template
# ==============================================================================

# 1. CORE SERVER RUNTIME
# Port for the Node.js Express server backend (Default: 3000)
PORT=3000

# Environment mode: 'development' | 'staging' | 'production'
NODE_ENV="development"

# App public hosting URL (automatically injected in AI Studio Cloud Run)
APP_URL="http://localhost:3000"

# 2. FRONTEND CLIENT ENVIRONMENT
# Base API endpoint URL for client requests (Optional - Defaults internally to '/api')
# VITE_API_BASE_URL="/api"

# Client environment tag: 'development' | 'staging' | 'production' (Optional - Defaults to Vite mode)
# VITE_APP_ENV="development"

# 3. AI & GEMINI CONFIGURATION
# Required for Gemini AI Astrologer and translation services
# Automatically injected at runtime in AI Studio from user secrets
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 4. CORS SECURITY BASELINE
# Allowed origin for Cross-Origin Resource Sharing (Optional - Defaults to '*' if unset)
# CORS_ALLOWED_ORIGIN="*"

# 5. FUTURE PRODUCTION PAYMENT GATEWAY (RAZORPAY / CASHFREE)
# Optional: Uncomment and configure these ONLY if live production payments are needed.
# (Unused and unneeded for running the Talk With Astrologers demo mode)
# RAZORPAY_KEY_ID="YOUR_RAZORPAY_KEY_ID"
# RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
# RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# 6. FUTURE SMS OTP AUTHENTICATION
# Optional: Uncomment and configure these ONLY if live SMS phone logins are needed.
# (Unused and unneeded for running the Talk With Astrologers demo mode)
# SMS_GATEWAY_API_KEY="YOUR_SMS_GATEWAY_API_KEY"
# SMS_SENDER_ID="TALKASTRO"

# 7. FIREBASE CLOUD MESSAGING (FCM) PRODUCTION PUSH NOTIFICATIONS
# Optional: Required ONLY for server-side push delivery to physical devices (Google FCM v1).
# Must be a secure server-side environment secret (NEVER expose to client or VITE_).
# FCM_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

